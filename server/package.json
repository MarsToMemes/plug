{
  "name": "plug-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plug API: script + voix → plan de montage style Apple (studio-engine) → planche de contrôle → rendu MP4.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup-engine": "node scripts/setup-engine.mjs",
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@fastify/multipart": "^9.0.3",
    "@runwayml/sdk": "4.20.1",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
