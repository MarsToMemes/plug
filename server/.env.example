# Clés de Plug. Une clé par ligne, sans espace autour du signe =, sans guillemets.
# Ce fichier (server/.env) reste sur votre Mac : il n'est jamais envoyé sur GitHub.
# Après une modification, fermez la fenêtre Plug et relancez Plug.

# Claude : réalisation du montage et description automatique de vos images (console.anthropic.com)
ANTHROPIC_API_KEY=

# Runway : génère une image ou une vidéo pour une phrase qui n'en a pas (dev.runwayml.com)
RUNWAYML_API_SECRET=

# ElevenLabs : voix IA générée depuis le script (elevenlabs.io), facultatif
ELEVENLABS_API_KEY=
